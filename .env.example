# Hangi sağlayıcı kullanılsın? openai | anthropic | gemini
LLM_PROVIDER=anthropic
# API anahtarları (en az birini doldurman yeterli)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Model adları (örnektir; güncel adları sağlayıcının dokümantasyonundan kontrol et)
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_MODEL=gemini-2.5-flash
